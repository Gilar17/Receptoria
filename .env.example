# NeonDB (PostgreSQL)
# DATABASE_URL — pooled connection (для приложения и Vercel)
# DIRECT_URL — direct connection (для миграций Prisma)

DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js (NextAuth v5)
AUTH_SECRET=""
# AUTH_URL="https://receptoria.vercel.app"  # production на Vercel

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Локальная БД для view-db (prisma dev или локальный PostgreSQL)
LOCAL_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/receptoria?sslmode=disable"
